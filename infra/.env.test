# =============================================================================
# ForgeOS — Test Environment Configuration
# =============================================================================
# Pre-configured for CI and local test runs. All values are safe for
# automated testing — no real secrets, no external dependencies.
#
# Usage:
#   cp infra/.env.test .env          # Before running tests locally
#   source infra/.env.test           # Or source directly
#
# Ticket: FORGEOS-DO004
# =============================================================================

# --- General ---
ENVIRONMENT=test
APP_NAME=forgeos-test
APP_VERSION=0.0.0-test

# --- Database ---
DATABASE_URL=postgresql://forgeos_test:test_password@localhost:5433/forgeos_test
DB_HOST=localhost
DB_PORT=5433
DB_NAME=forgeos_test
DB_USER=forgeos_test
DB_PASSWORD=test_password
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_SSL_MODE=disable

# --- MCP Server ---
PORT=3001
NODE_ENV=test
LOG_LEVEL=warn
ADMIN_API_KEY=test_admin_key_00000000
WEBHOOK_SECRET=test_webhook_secret_00000000
WORKSPACE_PATH=/tmp/forgeos-test-workspace
RATE_LIMIT_PER_MINUTE=1000

# --- Ticket / Lease ---
DEFAULT_LEASE_MINUTES=5
MAX_LEASE_MINUTES=15
RECONCILIATION_INTERVAL=10

# --- pgAdmin (disabled in test) ---
PGADMIN_EMAIL=test@forgeos.local
PGADMIN_PASSWORD=test_pgadmin_password
PGADMIN_PORT=5051

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_ENABLED=false

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:3001
TLS_CERT_PATH=
TLS_KEY_PATH=
JWT_SECRET=test_jwt_secret_do_not_use_in_prod
JWT_EXPIRY=15m

# --- Feature Flags ---
FEATURE_DASHBOARD=false
FEATURE_WEBHOOKS=false
FEATURE_AGENT_SDK=false
FEATURE_CHAOS=false
