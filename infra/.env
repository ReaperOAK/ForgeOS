# =============================================================================
# ForgeOS — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your target environment.
#
#   cp .env.template .env
#
# IMPORTANT: Never commit .env files containing real secrets to version control.
#            Use this template as the canonical reference for all variables.
#
# Profiles: Set ENVIRONMENT to one of: development | test | production
#
# Ticket: FORGEOS-DO004
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Environment profile: development | test | production
# Controls log verbosity, security enforcement, and feature flags.
ENVIRONMENT=development

# Application name (used in structured logs and tracing service name)
APP_NAME=forgeos

# Application version (injected at build/deploy time)
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------

# Full PostgreSQL connection URI.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# In Docker Compose the host is the service name (e.g. "postgres").
DATABASE_URL=postgresql://forgeos:changeme@localhost:5432/forgeos

# Individual connection components (used by settings.py if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forgeos
DB_USER=forgeos

# Database password — MUST be provided via env var or secret file.
# NEVER hardcode this value.
DB_PASSWORD=

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# SSL mode for PostgreSQL connections: disable | require | verify-ca | verify-full
DB_SSL_MODE=disable

# -----------------------------------------------------------------------------
# MCP Server (Node.js)
# -----------------------------------------------------------------------------

# Port the MCP server listens on
PORT=3011

# Node.js environment: development | production | test
NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Admin API key for privileged operations.
# MUST be changed from the default in production.
ADMIN_API_KEY=

# Webhook secret for validating incoming webhook payloads (HMAC-SHA256).
# Required in production.
WEBHOOK_SECRET=

# Filesystem path to the workspace root (optional; auto-detected if unset)
WORKSPACE_PATH=

# Rate-limiting: maximum requests per minute per client
RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Ticket / Lease Management
# -----------------------------------------------------------------------------

# Default lease duration (minutes) for ticket claims
DEFAULT_LEASE_MINUTES=30

# Maximum lease duration (minutes) allowed
MAX_LEASE_MINUTES=120

# Background reconciliation interval (seconds) for expired-lease cleanup
RECONCILIATION_INTERVAL=300

# -----------------------------------------------------------------------------
# pgAdmin (Database Administration UI)
# -----------------------------------------------------------------------------

# pgAdmin default login email
PGADMIN_EMAIL=admin@forgeos.local

# pgAdmin default login password — change in production
PGADMIN_PASSWORD=

# Port pgAdmin listens on
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# OpenTelemetry collector endpoint (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Tracing sample rate (0.0 to 1.0). Use 1.0 in dev/test, 0.05 in production.
OTEL_TRACES_SAMPLER_ARG=1.0

# Enable or disable tracing: true | false
OTEL_ENABLED=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# CORS allowed origins (comma-separated). Use '*' only in development.
CORS_ALLOWED_ORIGINS=http://localhost:3011

# TLS certificate and key paths (required in production)
TLS_CERT_PATH=
TLS_KEY_PATH=

# Session/JWT secret — MUST be set in production via env var or secret manager.
JWT_SECRET=

# JWT token expiry duration (e.g. "1h", "30m", "7d")
JWT_EXPIRY=1h

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable the web dashboard UI
FEATURE_DASHBOARD=true

# Enable webhook event delivery
FEATURE_WEBHOOKS=false

# Enable the experimental agent SDK endpoints
FEATURE_AGENT_SDK=false

# Enable chaos engineering experiment endpoints (never in production)
FEATURE_CHAOS=false

# -----------------------------------------------------------------------------
# Resource Limits (informational — enforced in docker-compose / K8s manifests)
# -----------------------------------------------------------------------------

# CPU limit for MCP server container (e.g. "0.50")
# MCP_CPU_LIMIT=0.50

# Memory limit for MCP server container (e.g. "256M")
# MCP_MEMORY_LIMIT=256M

# CPU limit for PostgreSQL container
# PG_CPU_LIMIT=0.50

# Memory limit for PostgreSQL container
# PG_MEMORY_LIMIT=256M
