# ForgeOS MCP Server — Environment Configuration
# Copy this file to .env and edit the values for your environment.
# See forgeos-server/README.md § Configuration for full details.
#
# Variables marked [REQUIRED] must be set. Others have sensible defaults.
# In production (NODE_ENV=production), WEBHOOK_SECRET and a non-default
# ADMIN_API_KEY are also required.

# ── PostgreSQL ──────────────────────────────────────────────────────────
# [REQUIRED] Full PostgreSQL connection URI.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://forgeos:forgeos_dev@localhost:5433/forgeos

# PostgreSQL listen port (informational — actual port is in DATABASE_URL).
POSTGRES_PORT=5433

# DB_PASSWORD is embedded in the DATABASE_URL connection string above.
# PGBOUNCER_PORT=6432  # Uncomment if using PgBouncer connection pooling.

# ── MCP Server ──────────────────────────────────────────────────────────
# HTTP port for the MCP Streamable HTTP server. Range: 1–65535.
PORT=3011

# Runtime environment. Controls validation strictness and logging.
# Values: development | production | test
NODE_ENV=development

# Pino structured logger verbosity.
# Values: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── Authentication ──────────────────────────────────────────────────────
# API key for admin access. CHANGE THIS before deploying.
# In production, the default value is rejected at startup.
ADMIN_API_KEY=forgeos_admin_CHANGE_ME_IMMEDIATELY

# ── GitHub Webhooks ─────────────────────────────────────────────────────
# HMAC secret for verifying GitHub webhook signatures.
# [REQUIRED in production]
WEBHOOK_SECRET=your_webhook_secret_here

# ── Workspace ───────────────────────────────────────────────────────────
# Absolute path to the Git workspace root (for file-lock detection).
WORKSPACE_PATH=/path/to/your/forgeos/repo

# ── Embeddings ──────────────────────────────────────────────────────────
# Use local Ollama embeddings by default.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=mxbai-embed-large
# When running via Docker Compose the Ollama hostname is 'ollama'.
# When running forgeos-server directly on host, use 127.0.0.1:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api/embed
OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate

# Required only for EMBEDDING_PROVIDER=openai.
# OPENAI_API_KEY=

# ── Prompt Compiler LLM ────────────────────────────────────────────────────
# Provider used by PromptArchitectService for execution packet synthesis.
# Values: ollama (local, default) | openai (cloud)
PROMPT_LLM_PROVIDER=ollama
PROMPT_LLM_MODEL=qwen2.5:7b-instruct

# ── Rate Limiting ───────────────────────────────────────────────────────
# Maximum API requests per minute per client. Minimum: 1.
RATE_LIMIT_PER_MINUTE=100

# ── Lease Defaults ──────────────────────────────────────────────────────
# Default ticket claim lease duration in minutes. Range: 5–120.
DEFAULT_LEASE_MINUTES=30

# Maximum allowed lease extension in minutes. Range: 10–480.
MAX_LEASE_MINUTES=120

# ── Reconciliation ──────────────────────────────────────────────────────
# Interval in seconds between expired-lease sweeps. Minimum: 60.
RECONCILIATION_INTERVAL=300
