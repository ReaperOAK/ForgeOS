{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CIReviewer",
          "version": "1.0.0",
          "informationUri": "https://github.com/ForgeOS/forgeos",
          "rules": [
            {
              "id": "CI-LINT-001",
              "name": "F541-ExtraneousFString",
              "shortDescription": { "text": "f-string without placeholders" },
              "defaultConfiguration": { "level": "warning" }
            },
            {
              "id": "CI-TYPE-001",
              "name": "MypyArgType",
              "shortDescription": { "text": "Incompatible argument type" },
              "defaultConfiguration": { "level": "warning" }
            },
            {
              "id": "CI-COMPLEXITY-001",
              "name": "CyclomaticComplexityHigh",
              "shortDescription": { "text": "Cyclomatic complexity exceeds threshold of 10" },
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CI-LINT-001",
          "level": "warning",
