{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CI-Reviewer",
          "version": "3.0.0",
          "rules": [
            {
              "id": "AF-005",
              "name": "Architecture/CoverageChangedFiles",
              "shortDescription": {
                "text": "Changed files must have at least 80% coverage"
              },
              "fullDescription": {
                "text": "Changed implementation files must meet minimum coverage threshold to pass CI gate."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": ["ci", "coverage", "architecture-fitness"],
                "priority": "critical"
              }
            },
            {
              "id": "CC-001",
              "name": "Complexity/CyclomaticThreshold",
              "shortDescription": {
                "text": "Function cyclomatic complexity exceeds threshold"
              },
              "fullDescription": {
                "text": "Cyclomatic complexity should remain <= 10 per function for maintainability and reviewability."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": ["ci", "complexity", "maintainability"],
                "priority": "warning"
              }
            },
            {
              "id": "OC-001",
              "name": "ObjectCalisthenics/OneIndentLevel",
              "shortDescription": {
                "text": "Nesting depth exceeds one level"
              },
              "fullDescription": {
                "text": "Object Calisthenics rule recommends one indentation level per method to reduce cognitive load."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": ["ci", "object-calisthenics", "maintainability"],
                "priority": "warning"
              }
            }
          ]
        }
      },
      "results": [],
      "invocations": [
        {
          "executionSuccessful": true,
          "properties": {
            "verdict": "APPROVE",
            "totalFindings": 0,
            "critical": 0,
            "warning": 0,
            "suggestion": 0,
            "qualityScore": 100,
            "filesReviewed": 3,
            "testsSummary": "2 test files passed, 22 tests passed",
            "typecheckSummary": "tsc --noEmit passed",
            "lintSummary": "scoped lint passed with 0 errors and 0 warnings for compiler.ts/compiler.test.ts/types/index.ts",
            "coverageSummary": "src/services/compiler.ts lines 88.59% in this run (threshold >=80%)"
          }
        }
      ]
    }
  ]
}
