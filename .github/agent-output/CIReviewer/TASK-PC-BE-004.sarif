{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CI-Reviewer",
          "version": "3.0.0",
          "rules": [
            {
              "id": "CI-CMD-001",
              "name": "InvalidCITargetPath",
              "shortDescription": {
                "text": "CI command references non-existent test file path"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": ["ci", "maintainability"],
                "priority": "🟡"
              }
            },
            {
              "id": "OC-001",
              "name": "ObjectCalisthenics/OneIndentLevel",
              "shortDescription": {
                "text": "Block nesting depth exceeds configured threshold"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": ["object-calisthenics", "maintainability"],
                "priority": "🟡"
              }
            },
            {
              "id": "CC-001",
              "name": "CyclomaticComplexityExceeded",
              "shortDescription": {
                "text": "Function complexity exceeds threshold"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": ["complexity", "maintainability"],
                "priority": "🟡"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CI-CMD-001",
          "level": "warning",
          "message": {
            "text": "Required CI lint command used non-existent path src/__tests__/packet-validator.test.ts; use src/services/packet-validator.test.ts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/src/__tests__/packet-validator.test.ts"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "priority": "🟡"
          }
        },
        {
          "ruleId": "OC-001",
          "level": "warning",
          "message": {
            "text": "Blocks are nested too deeply (2). Maximum allowed is 1."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/src/services/packet-validator.ts"
                },
                "region": {
                  "startLine": 70
                }
              }
            }
          ],
          "properties": {
            "priority": "🟡"
          }
        },
        {
          "ruleId": "OC-001",
          "level": "warning",
          "message": {
            "text": "Blocks are nested too deeply (3). Maximum allowed is 1."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/src/services/packet-validator.ts"
                },
                "region": {
                  "startLine": 71
                }
              }
            }
          ],
          "properties": {
            "priority": "🟡"
          }
        },
        {
          "ruleId": "OC-001",
          "level": "warning",
          "message": {
            "text": "Blocks are nested too deeply (2). Maximum allowed is 1."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/src/services/packet-validator.ts"
                },
                "region": {
                  "startLine": 85
                }
              }
            }
          ],
          "properties": {
            "priority": "🟡"
          }
        },
        {
          "ruleId": "CC-001",
          "level": "warning",
          "message": {
            "text": "Function validatePacketSections has cyclomatic complexity 19. Maximum allowed is 10."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/src/services/packet-validator.ts"
                },
                "region": {
                  "startLine": 100
                }
              }
            }
          ],
          "properties": {
            "priority": "🟡"
          }
        },
        {
          "ruleId": "OC-001",
          "level": "warning",
          "message": {
            "text": "Blocks are nested too deeply (2). Maximum allowed is 1."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/src/services/packet-validator.ts"
                },
                "region": {
                  "startLine": 116
                }
              }
            }
          ],
          "properties": {
            "priority": "🟡"
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "properties": {
            "verdict": "REQUEST_CHANGES",
            "totalFindings": 6,
            "critical": 0,
            "warning": 6,
            "suggestion": 0,
            "qualityScore": 70,
            "filesReviewed": 3
          }
        }
      ]
    }
  ]
}
