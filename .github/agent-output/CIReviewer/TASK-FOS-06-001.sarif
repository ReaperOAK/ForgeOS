{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ForgeOS-CIReviewer",
          "version": "1.0.0",
          "informationUri": "https://github.com/ReaperOAK/ForgeOS",
          "rules": [
            {
              "id": "CI-SPEC-001",
              "name": "MissingDependency",
              "shortDescription": { "text": "Required dependency missing from package.json" },
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "CI-SPEC-002",
              "name": "FilePathMismatch",
              "shortDescription": { "text": "Implementation file path deviates from ticket specification" },
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "CI-SPEC-003",
              "name": "FileNotTracked",
              "shortDescription": { "text": "Required file exists on disk but is not committed to version control" },
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "CI-SPEC-004",
              "name": "FileNotExecutable",
              "shortDescription": { "text": "Hook script file lacks executable permission" },
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "CI-SPEC-005",
              "name": "MissingRequiredFile",
              "shortDescription": { "text": "File declared in ticket file_paths does not exist" },
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "CI-SH-001",
              "name": "SubprocessAvoidance",
              "shortDescription": { "text": "Unnecessary subprocess where bash built-in suffices" },
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CI-SPEC-001",
          "level": "error",
          "message": {
            "text": "Acceptance criterion #1 requires 'Husky installed as devDependency in package.json with prepare: husky script'. package.json has no husky in devDependencies and no prepare script. Fix: npm install --save-dev husky && add '\"prepare\": \"husky\"' to scripts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "forgeos-server/package.json" },
                "region": { "startLine": 1 }
              }
            }
          ],
          "properties": {
            "severity": "critical",
            "category": "specification-violation"
          }
        },
        {
          "ruleId": "CI-SPEC-002",
          "level": "error",
          "message": {
            "text": "Ticket declares file_paths: ['forgeos-server/.husky/commit-msg'] but no .husky/ directory exists. Implementation found at forgeos-server/src/hooks/commit-msg.sh instead. Fix: Move to .husky/commit-msg or initialize Husky with npx husky init."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "forgeos-server/.husky/commit-msg" },
                "region": { "startLine": 1 }
              }
            }
          ],
          "properties": {
            "severity": "critical",
            "category": "specification-violation"
          }
        },
        {
          "ruleId": "CI-SPEC-003",
          "level": "error",
          "message": {
            "text": "forgeos-server/src/hooks/commit-msg.sh exists on disk but git ls-files returns empty for forgeos-server/src/hooks/. Acceptance criterion: 'committed to the repository'. Fix: git add forgeos-server/src/hooks/commit-msg.sh (after correcting path per CI-SPEC-002)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "forgeos-server/src/hooks/commit-msg.sh" },
                "region": { "startLine": 1 }
              }
            }
          ],
          "properties": {
            "severity": "critical",
            "category": "specification-violation"
          }
        },
        {
          "ruleId": "CI-SPEC-004",
          "level": "error",
          "message": {
            "text": "commit-msg.sh has 0644 permissions (rw-r--r--). Acceptance criterion: 'executable and committed'. Fix: chmod +x forgeos-server/src/hooks/commit-msg.sh (or .husky/commit-msg after move)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "forgeos-server/src/hooks/commit-msg.sh" },
                "region": { "startLine": 1 }
              }
            }
          ],
          "properties": {
            "severity": "critical",
            "category": "specification-violation"
          }
        },
        {
          "ruleId": "CI-SPEC-005",
          "level": "error",
          "message": {
            "text": "Ticket file_paths declares 'forgeos-server/scripts/validate-commit.sh' but this file does not exist anywhere in the repository (verified via find). Fix: Create the file or update ticket file_paths if design changed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "forgeos-server/scripts/validate-commit.sh" },
                "region": { "startLine": 1 }
              }
            }
          ],
          "properties": {
            "severity": "critical",
            "category": "specification-violation"
          }
        },
        {
          "ruleId": "CI-SH-001",
          "level": "warning",
          "message": {
            "text": "echo \"${COMMIT_MSG}\" | grep -qE spawns unnecessary subprocess. Use bash built-in regex: [[ \"${COMMIT_MSG}\" =~ ${TICKET_PATTERN} ]]. Minor performance improvement."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "forgeos-server/src/hooks/commit-msg.sh" },
                "region": { "startLine": 30 }
              }
            }
          ],
          "properties": {
            "severity": "warning",
            "category": "shell-best-practice"
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "startTimeUtc": "2026-03-06T02:30:00Z",
          "endTimeUtc": "2026-03-06T02:35:00Z",
          "properties": {
            "ticketId": "TASK-FOS-06-001",
            "qualityScore": 0,
            "verdict": "FAIL",
            "criticalCount": 5,
            "warningCount": 1,
            "suggestionCount": 0
          }
        }
      ]
    }
  ]
}
