{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ForgeOS-CIReviewer",
          "version": "1.0.0",
          "rules": [
            {
              "id": "CI-OC-002",
              "name": "NoElseKeyword",
              "shortDescription": {
                "text": "Object Calisthenics: avoid ELSE keyword, prefer early returns"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CI-OC-002",
          "level": "note",
          "message": {
            "text": "else: keyword used in success/error logging branch. Could extract to early return pattern but acceptable for dual-path structured logging."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mcp-server/src/mcp_server/migration/cleanup.py"
                },
                "region": {
                  "startLine": 171,
                  "endLine": 181
                }
              }
            }
          ]
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "properties": {
            "qualityScore": 95,
            "verdict": "PASS",
            "lintErrors": 0,
            "lintWarnings": 0,
            "typeErrors": 0,
            "maxCyclomaticComplexity": 8,
            "averageCyclomaticComplexity": 1.97,
            "testsPassed": 51,
            "testsFailed": 0,
            "coveragePercent": 98,
            "criticalFindings": 0,
            "warningFindings": 0,
            "suggestionFindings": 1
          }
        }
      ]
    }
  ]
}
