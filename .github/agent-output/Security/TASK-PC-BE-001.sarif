{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SecurityEngineer-Agent",
          "version": "2.0.0",
          "informationUri": "https://owasp.org/www-project-top-ten/",
          "rules": [
            {
              "id": "SEC-A06-MODERATE-DEP",
              "name": "ModerateDependencyAdvisory",
              "shortDescription": {
                "text": "Moderate dependency advisory detected (non-blocking for this ticket)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "owasp": "A06:2021",
                "cwe": "CWE-1321"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SEC-A06-MODERATE-DEP",
          "level": "warning",
          "message": {
            "text": "npm audit reported GHSA-v8w9-8mx6-g223 in transitive dependency hono (<4.12.7). No high/critical advisories; non-blocking for TASK-PC-BE-001 scope."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/package-lock.json"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
