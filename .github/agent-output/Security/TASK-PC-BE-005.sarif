{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SecurityEngineer-Agent",
          "version": "2.0.0",
          "rules": [
            {
              "id": "SEC-INP-001",
              "name": "MissingTicketIdBoundaryValidation",
              "shortDescription": {
                "text": "orchestrateCompilePipeline does not validate ticketId shape/length before use"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "severity": "medium",
                "owasp": "A04:2021",
                "cwe": "CWE-20"
              }
            },
            {
              "id": "SEC-DEP-001",
              "name": "ModerateDependencyVulnerability",
              "shortDescription": {
                "text": "npm audit reported a moderate dependency vulnerability"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "severity": "low",
                "owasp": "A06:2021",
                "cwe": "CWE-1104"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SEC-INP-001",
          "level": "warning",
          "message": {
            "text": "No explicit ticketId input validation is performed in orchestrateCompilePipeline before forwarding to downstream compilation/persistence logic."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/src/services/compile-orchestrator.ts"
                },
                "region": {
                  "startLine": 11
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC-DEP-001",
          "level": "note",
          "message": {
            "text": "npm audit --audit-level=high found 1 moderate vuln (hono <4.12.7, GHSA-v8w9-8mx6-g223); high and critical findings are zero."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "forgeos-server/package-lock.json"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
