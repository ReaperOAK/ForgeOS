# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# These are loaded automatically by the CLI when `dotenv` is installed.

# Base64-encoded 32-byte key encryption key for Corsair's secret store.
CORSAIR_KEK=

# Optional: path to Corsair's local SQLite store (default: corsair.db).
CORSAIR_DB=corsair.db
